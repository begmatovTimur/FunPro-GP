{
  "id": "q2-race-classification",
  "order": 1,
  "title": "Race Classification",
  "difficulty": "Medium",
  "statement": "The race is over and the stewards need the official classification.\n\nYou get every lap time of every driver. A driver's race time is the sum of their lap times. Sort the drivers by race time (fastest first). If two drivers have the same time, the one listed **earlier in the input** is classified ahead.\n\n- The winner's line shows the total race time as `h:mm:ss.sss`.\n- Every other line shows the gap to the winner as `+s.sss` (whole seconds, then exactly 3 digits of milliseconds; seconds may be more than 59, for example `+75.300`).",
  "input_format": "The first line contains `n` and `m`: the number of drivers and the number of laps.\nEach of the next `n` lines contains a driver code followed by `m` lap times in milliseconds.",
  "output_format": "`n` lines: `position code time` for the winner, then `position code +gap` for everyone else.",
  "constraints": [
    "1 ≤ n ≤ 20",
    "1 ≤ m ≤ 70",
    "0 ≤ lap time ≤ 3600000"
  ],
  "examples": [
    {
      "input": "3 3\nVER 92000 91500 91800\nNOR 91900 91700 91600\nLEC 92500 92100 92300\n",
      "explanation": "Totals: VER 275300, NOR 275200, LEC 276900 ms. NOR wins in 0:04:35.200.",
      "output": "1 NOR 0:04:35.200\n2 VER +0.100\n3 LEC +1.700\n"
    }
  ],
