  "title": "Driver Code",
  "difficulty": "Easy",
  "statement": "On the timing tower every driver is shown by a three-letter code: the **first three letters of their last name**, in UPPERCASE. For example `Kimi Antonelli` → `ANT`.\n\nGiven a full name, print the code. The name may be written in any letter case and may contain extra spaces.",
  "input_format": "One line with the full name: two or more words made of English letters.",
  "output_format": "The three-letter code.",
  "constraints": [
    "The last name has at least 3 letters",
    "The line is at most 100 characters long"
  ],
  "examples": [
    {
      "input": "Kimi Antonelli\n",
      "output": "ANT\n"
    },
    {
      "input": "  max   VERSTAPPEN \n",
      "output": "VER\n"
    }
  ],
